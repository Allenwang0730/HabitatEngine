<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Habitat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/habitat_primary</item>
        <item name="colorOnPrimary">@color/habitat_on_primary</item>
        <item name="colorPrimaryContainer">@color/habitat_primary_container</item>
        <item name="colorSecondary">@color/habitat_secondary</item>
        <item name="android:colorBackground">@color/habitat_background</item>
        <item name="android:windowBackground">@color/habitat_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Habitat.Transparent" parent="Theme.Habitat">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
