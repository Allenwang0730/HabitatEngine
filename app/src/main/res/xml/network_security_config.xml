<?xml version="1.0" encoding="utf-8"?>
<!-- 明文 HTTP 保留允许：工作流需要访问局域网 HTTP 设备。登录/注册凭据由 HabitatApiClient 强制 https。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- 用户安装的 CA（抓包调试）仅 debug 构建信任 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
